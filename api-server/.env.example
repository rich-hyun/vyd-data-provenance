# VYD 메인넷
RPC_URL=https://vyd.mustree.kr
CHAIN_ID=7603
# scripts/deploy.mjs 실행 후 나온 값
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DEPLOY_BLOCK=0
# 서버 서명 계정 (REGISTRAR_ROLE + AUDITOR_ROLE 필요). 절대 저장소에 커밋하지 마세요.
PRIVATE_KEY=0x...
# 이름:키:권한(write,read,verify) 를 ; 로 구분
API_KEYS=pipeline:vyk_live_change_me_1:write,read,verify;portal:vyk_live_change_me_2:read,verify
PORT=8080
CORS_ORIGIN=*
ANCHOR_SIZE=10
RATE_LIMIT_PER_MIN=600
# 무료 가스 네트워크면 0, 아니면 비워 두기
GAS_PRICE=
DATA_DIR=data
